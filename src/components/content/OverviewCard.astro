---
interface Props {
  title: string;
  summary: string;
  href: string;
  linkLabel: string;
}

const { title, summary, href, linkLabel } = Astro.props;
---

<article class="overview-card">
  <div>
    <h3>{title}</h3>
    <p>{summary}</p>
  </div>
  <a href={href} aria-label={`${linkLabel}: ${title}`}>{linkLabel}<span aria-hidden="true"> →</span></a>
</article>
