---
import { SOCIALS, SOCIAL_ICONS } from "../../config";
import { getCollection } from "astro:content";
import Icon from "../ui/Icon.astro";
import { Image } from 'astro:assets';
import headshot from '../../assets/headshot.jpg';

const activeSocials = SOCIALS.filter((s) => s.isActive);
const bioCollection = await getCollection("bio");
const bio = bioCollection[0]?.data;
const [institution, location] = bio?.institution.split(" · ") ?? [];
---

<aside class="sidebar">
    <div class="sidebar-profile">
        {bio?.avatar && (
            <Image
                src={headshot}
                alt={`Professional headshot of ${bio.name}`}
                width={160}
                height={160}
                densities={[1.5, 2]} 
                format="webp"
                class="sidebar-avatar"
                loading="eager"
            />
        )}
        <div class="sidebar-details">
            {bio?.name && <h1 class="sidebar-name">{bio.name}</h1>}
            {bio?.institution && (
                <p class="sidebar-affiliation" aria-label={bio.institution}>
                    <span>{institution}</span>
                    {location && <span class="sidebar-location">{location}</span>}
                </p>
            )}
            {bio?.shortBio && (
                <p class="sidebar-bio">{bio.shortBio}</p>
            )}
            <div class="sidebar-socials">
                {activeSocials.map((social) => (
                    <a
                        href={social.href}
                        aria-label={social.linkTitle}
                        title={social.linkTitle}
                        target="_blank"
                        rel="noreferrer"
                        class="social-link"
                    >
                        <Icon name={SOCIAL_ICONS[social.name] || social.name} size={24} />
                    </a>
                ))}
            </div>
        </div>
    </div>
</aside>
